# LUMEN PEPTIDES - ENVIRONMENT CONFIGURATION
PORT=3000
NODE_ENV=development

# BITCOIN LIGHTNING NETWORK CONFIGURATION
# Options: "mock" (built-in simulator with real BOLT11 and instant test settlement), "lnbits", "btcpay", "opennode"
LN_PROVIDER=mock

# LNBITS CONFIG (Optional - if using LN_PROVIDER=lnbits)
LNBITS_ENDPOINT=https://legend.lnbits.com
LNBITS_INVOICE_KEY=your_lnbits_invoice_read_key

# BTCPAY SERVER CONFIG (Optional - if using LN_PROVIDER=btcpay)
BTCPAY_SERVER_URL=https://btcpay.yourdomain.com
BTCPAY_STORE_ID=your_btcpay_store_id
BTCPAY_API_KEY=your_btcpay_api_key

# STORE SETTINGS
STORE_NAME=Lumen Peptides
SUPPORT_EMAIL=research@lumenpeptides.com
LIGHTNING_ADDRESS=payments@lumenpeptides.com
